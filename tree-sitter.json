{
  "grammars": [
    {
      "name": "gosu",
      "camelcase": "Gosu",
      "scope": "source.gosu",
      "path": ".",
      "file-types": [
        "gs",
        "gsx",
        "gsp"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A Tree-sitter grammar that parses Gosu, a statically typed, JVM-based general-purpose programming language.",
    "authors": [
      {
        "name": "Ron Webb",
        "email": "ron@ronella.xyz"
      }
    ],
    "links": {
      "repository": "https://github.com/RonWebb/tree-sitter-gosu"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": true,
    "rust": false,
    "swift": false
  }
}
